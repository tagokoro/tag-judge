LOCALSTACK_PORT=4566
JUDGE_SUBMISSIONS_QUEUE_NAME=judge-submissions
JUDGE_SUBMISSIONS_DLQ_NAME=judge-submissions-dlq
JUDGE_STORAGE_BUCKET=judge-storage
