POSTGRES_DB=judge
POSTGRES_USER=judge_user
POSTGRES_PASSWORD=judge_pass
POSTGRES_PORT=5432

# --- Go API (localhost:8080, API only) ---
PORT=8080
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The browser talks to the Next.js origin (localhost:3000). Its /api/:path*
# rewrite forwards the callback to the Go API, so the HttpOnly session cookie
# is set on the same origin the browser uses. Register this exact URI in the
# Google OAuth console for local development.
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000/api/v1/auth/google/callback
AUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
DEV_HEADER_AUTH=true
SOURCE_CODE_ROOT=/tmp/tag-judge-sources
CODE_RUN_TIME_LIMIT_MS=5000

# --- Next.js frontend (localhost:3000, separate process) ---
# Server-side only: read by frontend/next.config.ts, intentionally NOT prefixed
# with NEXT_PUBLIC_ so it is never exposed to the browser. When unset, the
# /api/:path* rewrite falls back to http://localhost:8080 (the Go API).
# See frontend/.env.example and frontend/README.md. The frontend requires
# Node.js >= 20.9.0 and npm >= 10 (Next.js 16 minimum).
API_SERVER_ORIGIN=http://localhost:8080

# Admission control defaults. All values must be positive integers.
ADMISSION_USER_RATE_LIMIT=10
ADMISSION_USER_RATE_WINDOW_SECONDS=60
ADMISSION_USER_OUTSTANDING_LIMIT=2
ADMISSION_GLOBAL_OUTSTANDING_LIMIT=100
ADMISSION_LOCK_TIMEOUT_MS=5000
IDEMPOTENCY_KEY_MAX_LENGTH=255

AWS_DEFAULT_REGION=ap-northeast-1
AWS_ENDPOINT_URL=http://localhost:4566
LOCALSTACK_PORT=4566
JUDGE_SUBMISSIONS_QUEUE_NAME=judge-submissions
JUDGE_SUBMISSIONS_DLQ_NAME=judge-submissions-dlq
JUDGE_STORAGE_BUCKET=judge-storage
JUDGE_DATABASE_URL=postgres://judge_user:judge_pass@localhost:5432/judge?sslmode=disable
