#!/bin/bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive
export HOME=/root

apt-get update
apt-get install -y \
  ca-certificates \
  curl \
  git \
  python3 \
  python3-boto3 \
  libssl-dev

swap_file=/swapfile
if [ ! -f "$swap_file" ]; then
  fallocate -l 4G "$swap_file" || dd if=/dev/zero of="$swap_file" bs=1M count=4096
  chmod 600 "$swap_file"
  mkswap "$swap_file"
fi
if ! swapon --show=NAME | grep -q "^$swap_file$"; then
  swapon "$swap_file"
fi
grep -q "^$swap_file " /etc/fstab || echo "$swap_file none swap sw 0 0" >>/etc/fstab

if snap list amazon-ssm-agent >/dev/null 2>&1; then
  snap start --enable amazon-ssm-agent || snap start amazon-ssm-agent || true
elif systemctl list-unit-files | grep -q '^amazon-ssm-agent.service'; then
  systemctl enable amazon-ssm-agent
  systemctl restart amazon-ssm-agent
else
  curl -fsSL \
    "https://s3.${aws_region}.amazonaws.com/amazon-ssm-${aws_region}/latest/debian_amd64/amazon-ssm-agent.deb" \
    -o /tmp/amazon-ssm-agent.deb
  dpkg -i /tmp/amazon-ssm-agent.deb
  systemctl enable amazon-ssm-agent
  systemctl restart amazon-ssm-agent
fi

apt-get install -y \
  build-essential \
  libcap-dev \
  libseccomp-dev \
  libsystemd-dev \
  pkg-config

if ! command -v isolate >/dev/null 2>&1; then
  rm -rf /tmp/isolate
  git clone --depth 1 --branch "${isolate_git_ref}" https://github.com/ioi/isolate.git /tmp/isolate
  make -C /tmp/isolate install
  if ! id -u isolate >/dev/null 2>&1; then
    useradd --system --no-create-home --shell /usr/sbin/nologin isolate
  fi
  grep -q '^isolate:' /etc/subuid || echo 'isolate:60000:65536' >>/etc/subuid
  grep -q '^isolate:' /etc/subgid || echo 'isolate:60000:65536' >>/etc/subgid
  systemctl daemon-reload
  systemctl enable --now isolate.service
fi

if ! id -u "${worker_user}" >/dev/null 2>&1; then
  useradd --system --create-home --shell /usr/sbin/nologin "${worker_user}"
fi

install -d -o "${worker_user}" -g "${worker_user}" /opt/tag-judge

if [ ! -d /opt/tag-judge/.git ]; then
  git clone "${repository_url}" /opt/tag-judge
fi

git config --system --add safe.directory /opt/tag-judge

cd /opt/tag-judge
git fetch --all
git checkout "${repository_ref}"
git pull --ff-only || true
chown -R "${worker_user}:${worker_user}" /opt/tag-judge

curl https://sh.rustup.rs -sSf | sh -s -- -y --default-toolchain "${rust_toolchain}"
. /root/.cargo/env

cd /opt/tag-judge/judge/worker
export CARGO_BUILD_JOBS=1
cargo build --release --jobs 1

cat >/etc/systemd/system/judge-worker.service <<EOF
[Unit]
Description=tag-judge worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tag-judge/judge/worker
ExecStart=/opt/tag-judge/judge/worker/target/release/judge-worker
Restart=always
RestartSec=5
Environment=AWS_DEFAULT_REGION=${aws_region}
Environment=JUDGE_SUBMISSIONS_QUEUE_NAME=${queue_name}
Environment=JUDGE_STORAGE_BUCKET=${bucket_name}
EnvironmentFile=/etc/tag-judge/worker.env
[Install]
WantedBy=multi-user.target
EOF

python3 - "${aws_region}" <<'PY'
import hashlib
import re
import subprocess
import sys
import urllib.request
from pathlib import Path

region = sys.argv[1]

# ① AWS公式から、このリージョンの証明書バンドルを取得
url = (
    f"https://truststore.pki.rds.amazonaws.com/"
    f"{region}/{region}-bundle.pem"
)
with urllib.request.urlopen(url, timeout=30) as response:
    bundle = response.read().decode("ascii")

certificates = re.findall(
    r"-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----",
    bundle,
    re.DOTALL,
)

trust_dir = Path("/usr/local/share/ca-certificates")
trust_dir.mkdir(parents=True, exist_ok=True)
installed = 0

for certificate in certificates:
    # ② subjectとissuerが同じ、自己署名のルートを選ぶ
    result = subprocess.run(
        [
            "openssl", "x509", "-noout",
            "-subject", "-issuer", "-nameopt", "RFC2253",
        ],
        input=certificate,
        text=True,
        capture_output=True,
        check=True,
    )

    lines = result.stdout.splitlines()
    subject = lines[0].split("=", 1)[1]
    issuer = lines[1].split("=", 1)[1]

    if subject != issuer:
        continue

    fingerprint = hashlib.sha256(certificate.encode()).hexdigest()
    destination = trust_dir / f"tag-judge-rds-{fingerprint}.crt"
    destination.write_text(certificate + "\n", encoding="ascii")
    destination.chmod(0o644)
    installed += 1

if installed == 0:
    raise RuntimeError("RDSのルート証明書が見つかりません")

print(f"RDSルート証明書を{installed}件配置しました")
PY

# ③ Ubuntuの信頼ストアへ反映
update-ca-certificates

# Only metadata is interpolated here. The secret value stays out of user data
# and shell tracing; the Python process writes it directly to a root-only file.
/usr/bin/python3 - \
  --region "${aws_region}" \
  --secret-arn "${db_secret_arn}" \
  --host "${db_host}" \
  --port "${db_port}" \
  --database "${db_name}" <<'WORKER_DB_PY'
${worker_db_env_script}
WORKER_DB_PY

systemctl daemon-reload
systemctl enable judge-worker
systemctl restart judge-worker
