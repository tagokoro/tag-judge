#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y ca-certificates curl git python3 python3-boto3

curl --retry 3 -fsSL \
  https://amazoncloudwatch-agent.s3.amazonaws.com/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb \
  -o /tmp/amazon-cloudwatch-agent.deb
dpkg -i /tmp/amazon-cloudwatch-agent.deb

if snap list amazon-ssm-agent >/dev/null 2>&1; then
  snap start --enable amazon-ssm-agent
elif systemctl list-unit-files amazon-ssm-agent.service --no-legend | grep -q '^amazon-ssm-agent.service'; then
  systemctl enable --now amazon-ssm-agent
else
  curl --retry 3 -fsSL "https://s3.${aws_region}.amazonaws.com/amazon-ssm-${aws_region}/latest/debian_amd64/amazon-ssm-agent.deb" -o /tmp/amazon-ssm-agent.deb
  dpkg -i /tmp/amazon-ssm-agent.deb
  systemctl enable --now amazon-ssm-agent
fi

# Fetch the pinned release and verify its archive against Go's release metadata.
python3 - '${go_version}' <<'PY'
import hashlib
import json
from pathlib import Path
import sys
import urllib.request

version = "go" + sys.argv[1]
with urllib.request.urlopen("https://go.dev/dl/?mode=json&include=all", timeout=60) as response:
    releases = json.load(response)
release = next(item for item in releases if item["version"] == version)
archive = next(item for item in release["files"] if item["os"] == "linux" and item["arch"] == "amd64" and item["kind"] == "archive")
with urllib.request.urlopen("https://go.dev/dl/" + archive["filename"], timeout=120) as response:
    data = response.read()
if hashlib.sha256(data).hexdigest() != archive["sha256"]:
    raise RuntimeError("Go archive checksum mismatch")
Path("/tmp/tag-judge-go.tar.gz").write_bytes(data)
PY
tar -C /usr/local -xzf /tmp/tag-judge-go.tar.gz
rm /tmp/tag-judge-go.tar.gz

id -u judge-api >/dev/null 2>&1 || useradd --system --create-home --shell /usr/sbin/nologin judge-api
install -d -o judge-api -g judge-api /opt/tag-judge-api
runuser -u judge-api -- git clone '${repository_url}' /opt/tag-judge-api
runuser -u judge-api -- git -C /opt/tag-judge-api checkout --detach '${repository_ref}'
cd /opt/tag-judge-api/backend
runuser -u judge-api -- env GOTOOLCHAIN=local CGO_ENABLED=0 /usr/local/go/bin/go build -mod=readonly -trimpath -o /opt/tag-judge-api/api ./cmd/api

install -d -m 0700 /etc/tag-judge
install -d -m 0750 /var/log/tag-judge
curl --retry 3 -fsSL 'https://truststore.pki.rds.amazonaws.com/${aws_region}/${aws_region}-bundle.pem' -o /etc/tag-judge/rds-bundle.pem
# The service user needs to read only the public CA bundle, not api.env.
install -m 0644 /etc/tag-judge/rds-bundle.pem /opt/tag-judge-api/rds-bundle.pem

install -d -m 0700 /opt/tag-judge-setup
cat >/opt/tag-judge-setup/configure_service_env.py <<'SERVICE_ENV_PY'
${service_env_script}
SERVICE_ENV_PY
python3 /opt/tag-judge-setup/configure_service_env.py \
  --region '${aws_region}' --secret-arn '${secret_arn}' --service api

cat >/etc/systemd/system/judge-api.service <<'SERVICE'
[Unit]
Description=tag-judge API server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=judge-api
Group=judge-api
WorkingDirectory=/opt/tag-judge-api/backend
ExecStart=/opt/tag-judge-api/api
Environment=PORT=8080
Environment=AWS_DEFAULT_REGION=${aws_region}
Environment=JUDGE_STORAGE_BUCKET=${bucket_name}
Environment=JUDGE_SUBMISSIONS_QUEUE_NAME=${queue_name}
Environment=DEV_HEADER_AUTH=${dev_header_auth}
Environment=COOKIE_SECURE=${cookie_secure}
EnvironmentFile=/etc/tag-judge/api.env
StandardOutput=append:/var/log/tag-judge/api.log
StandardError=append:/var/log/tag-judge/api.log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
SERVICE
systemctl daemon-reload
systemctl enable --now judge-api
%{ if frontend_enabled ~}

# The frontend builds on this instance next to the API. next build can use
# more memory than a t3.small has left beside the API, so give it swap.
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  echo '/swapfile none swap sw 0 0' >>/etc/fstab
fi
swapon /swapfile || true

# Fetch the pinned Node.js release and verify it against the release's SHASUMS256.txt.
python3 - '${node_version}' <<'PY'
import hashlib
from pathlib import Path
import sys
import urllib.request

version = "v" + sys.argv[1]
filename = "node-" + version + "-linux-x64.tar.xz"
base = "https://nodejs.org/dist/" + version + "/"
with urllib.request.urlopen(base + "SHASUMS256.txt", timeout=60) as response:
    sums = response.read().decode()
expected = next(line.split()[0] for line in sums.splitlines() if line.split()[1] == filename)
with urllib.request.urlopen(base + filename, timeout=300) as response:
    data = response.read()
if hashlib.sha256(data).hexdigest() != expected:
    raise RuntimeError("Node.js archive checksum mismatch")
Path("/tmp/tag-judge-node.tar.xz").write_bytes(data)
PY
install -d /opt/node
tar -C /opt/node --strip-components=1 -xJf /tmp/tag-judge-node.tar.xz
rm /tmp/tag-judge-node.tar.xz

# The rewrites to the Go API are baked in at build time, so build against the
# local API the service will reach at run time.
cd /opt/tag-judge-api/frontend
runuser -u judge-api -- env HOME=/home/judge-api PATH=/opt/node/bin:/usr/bin:/bin \
  NEXT_TELEMETRY_DISABLED=1 npm ci --no-audit --no-fund
runuser -u judge-api -- env HOME=/home/judge-api PATH=/opt/node/bin:/usr/bin:/bin \
  NEXT_TELEMETRY_DISABLED=1 API_SERVER_ORIGIN=http://127.0.0.1:8080 npm run build

id -u judge-web >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin judge-web
rm -rf /opt/tag-judge-web
cp -R .next/standalone /opt/tag-judge-web
cp -R .next/static /opt/tag-judge-web/.next/static
chown -R root:root /opt/tag-judge-web
# Next.js writes its cache at run time; everything else stays read-only.
install -d -o judge-web -g judge-web /opt/tag-judge-web/.next/cache

cat >/etc/systemd/system/judge-web.service <<'SERVICE'
[Unit]
Description=tag-judge frontend (Next.js)
Wants=network-online.target judge-api.service
After=network-online.target judge-api.service

[Service]
Type=simple
User=judge-web
Group=judge-web
WorkingDirectory=/opt/tag-judge-web
ExecStart=/opt/node/bin/node /opt/tag-judge-web/server.js
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
Environment=API_SERVER_ORIGIN=http://127.0.0.1:8080
Environment=NEXT_TELEMETRY_DISABLED=1
StandardOutput=append:/var/log/tag-judge/web.log
StandardError=append:/var/log/tag-judge/web.log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tag-judge-web/.next/cache

[Install]
WantedBy=multi-user.target
SERVICE
systemctl daemon-reload
systemctl enable --now judge-web
%{ endif ~}

cat >/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CLOUDWATCH_CONFIG'
{
  "agent": {"run_as_user": "root"},
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [{
          "file_path": "/var/log/tag-judge/api.log",
          "log_group_name": "${log_group_name}",
          "log_stream_name": "{instance_id}",
          "timezone": "UTC"
        }%{ if frontend_enabled }, {
          "file_path": "/var/log/tag-judge/web.log",
          "log_group_name": "${log_group_name}",
          "log_stream_name": "{instance_id}-web",
          "timezone": "UTC"
        }%{ endif }]
      }
    }
  }
}
CLOUDWATCH_CONFIG
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
