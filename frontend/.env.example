# Server-side only. The Next.js rewrite
#   /api/:path* -> ${API_SERVER_ORIGIN}/api/:path*
# resolves this destination on the server, so it is intentionally NOT prefixed
# with NEXT_PUBLIC_ and is never exposed to the browser bundle.
#
# Local development fallback (when unset): http://localhost:8080 (the Go API).
# Production deployments must set this to the private Go API origin.
API_SERVER_ORIGIN=http://localhost:8080
